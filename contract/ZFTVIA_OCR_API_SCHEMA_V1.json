{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltfoods.example/zftvia/ocr-invoice-v1.schema.json",
  "title": "ZFTVIA OCR invoice result – GET /api/v1/invoices/{id} (api_version 1)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "status",
    "api_version",
    "invoice_header",
    "line_items",
    "additional_fields",
    "tax_details",
    "purchase_order_items",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "success",
        "needs_review",
        "error"
      ]
    },
    "api_version": {
      "type": "string",
      "const": "1"
    },
    "filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "pdf_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "document_count_estimate": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "invoice_header": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "invoice_number",
        "invoice_date",
        "due_date",
        "payment_terms",
        "company_code",
        "vendor_name",
        "vendor_address",
        "vendor_tax_id",
        "vendor_country",
        "vendor_bank_name",
        "vendor_account_no",
        "vendor_sort_code",
        "vendor_iban",
        "customer_name",
        "customer_address",
        "po_number",
        "reference_number",
        "currency",
        "subtotal",
        "tax_amount",
        "tax_percent",
        "total_amount",
        "document_type",
        "document_direction",
        "invoice_period_from",
        "invoice_period_to"
      ],
      "properties": {
        "invoice_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "invoice_date": {
          "$ref": "#/$defs/date"
        },
        "due_date": {
          "$ref": "#/$defs/date"
        },
        "payment_terms": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 140
        },
        "vendor_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_tax_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "vendor_country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "vendor_bank_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_account_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_sort_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_iban": {
          "type": [
            "string",
            "null"
          ]
        },
        "customer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "customer_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "po_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 35
        },
        "reference_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "subtotal": {
          "$ref": "#/$defs/amount"
        },
        "tax_amount": {
          "$ref": "#/$defs/amount"
        },
        "tax_percent": {
          "$ref": "#/$defs/pct"
        },
        "total_amount": {
          "$ref": "#/$defs/amount"
        },
        "document_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "INVOICE",
            "CREDIT_NOTE",
            "DEBIT_NOTE",
            "DELIVERY_NOTE",
            "TIMESHEET",
            "PROFORMA",
            "STATEMENT",
            "OTHER",
            null
          ]
        },
        "document_direction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VENDOR_TO_CUSTOMER",
            "CUSTOMER_TO_VENDOR",
            null
          ]
        },
        "invoice_period_from": {
          "$ref": "#/$defs/date"
        },
        "invoice_period_to": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_no",
          "description",
          "quantity",
          "unit",
          "unit_price",
          "amount",
          "tax_percent",
          "tax_amount",
          "reference_code",
          "po_number",
          "po_item",
          "gl_account",
          "cost_center",
          "profit_center"
        ],
        "properties": {
          "line_no": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10
          },
          "unit_price": {
            "type": [
              "number",
              "null"
            ]
          },
          "amount": {
            "$ref": "#/$defs/amount"
          },
          "tax_percent": {
            "$ref": "#/$defs/pct"
          },
          "tax_amount": {
            "$ref": "#/$defs/amount"
          },
          "reference_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "po_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "po_item": {
            "type": [
              "string",
              "null"
            ]
          },
          "gl_account": {
            "type": "null"
          },
          "cost_center": {
            "type": "null"
          },
          "profit_center": {
            "type": "null"
          }
        }
      }
    },
    "additional_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_name",
          "field_value"
        ],
        "properties": {
          "field_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "field_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        }
      }
    },
    "tax_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tax_type",
          "tax_rate",
          "tax_amount",
          "taxable_amount"
        ],
        "properties": {
          "tax_type": {
            "type": "string",
            "enum": [
              "VAT",
              "GST",
              "CGST",
              "SGST",
              "IGST",
              "UTGST",
              "CESS",
              "SALES_TAX",
              "WHT",
              "OTHER"
            ]
          },
          "tax_rate": {
            "$ref": "#/$defs/pct"
          },
          "tax_amount": {
            "$ref": "#/$defs/amount"
          },
          "taxable_amount": {
            "$ref": "#/$defs/amount"
          }
        }
      }
    },
    "purchase_order_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "po_number",
          "po_item",
          "invoice_line_no",
          "quantity",
          "unit_price",
          "amount"
        ],
        "properties": {
          "po_number": {
            "type": "string"
          },
          "po_item": {
            "type": [
              "string",
              "null"
            ]
          },
          "invoice_line_no": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit_price": {
            "type": [
              "number",
              "null"
            ]
          },
          "amount": {
            "$ref": "#/$defs/amount"
          }
        }
      }
    },
    "confidence": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "invoice_number",
        "invoice_date",
        "vendor_name",
        "vendor_tax_id",
        "po_number",
        "total_amount",
        "subtotal",
        "tax_amount",
        "currency",
        "document_type"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/conf"
      },
      "properties": {
        "invoice_number": {
          "$ref": "#/$defs/conf"
        },
        "invoice_date": {
          "$ref": "#/$defs/conf"
        },
        "vendor_name": {
          "$ref": "#/$defs/conf"
        },
        "vendor_tax_id": {
          "$ref": "#/$defs/conf"
        },
        "po_number": {
          "$ref": "#/$defs/conf"
        },
        "total_amount": {
          "$ref": "#/$defs/conf"
        },
        "subtotal": {
          "$ref": "#/$defs/conf"
        },
        "tax_amount": {
          "$ref": "#/$defs/conf"
        },
        "currency": {
          "$ref": "#/$defs/conf"
        },
        "document_type": {
          "$ref": "#/$defs/conf"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "success",
              "needs_review"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "invoice_header": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "conf": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
