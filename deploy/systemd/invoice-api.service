[Unit]
Description=LT Foods Invoice Extraction API
After=network.target

[Service]
Type=simple
User=invoice-service
Group=invoice-service
WorkingDirectory=/opt/invoice-service
EnvironmentFile=/opt/invoice-service/.env
# --workers 4 runs 4 independent Uvicorn processes. Safe for GET /api/v1/invoices/new:
# results are claimed by an atomic file rename (app/storage/results_store.py), so each
# result goes to exactly one request. Tune the worker count to CPU core count on the box.
ExecStart=/opt/invoice-service/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
